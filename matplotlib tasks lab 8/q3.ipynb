    "import matplotlib.pyplot as plt\n",
    "\n",
    "flavors = [\"Vanilla\",\"Chocolate\",\"Strawberry\",\"Mango\",\"Oreo\"]\n",
    "scoops = [120,150,90,110,80]\n",
    "\n",
    "plt.pie(scoops, labels=flavors, autopct=\"%1.1f%%\")\n",
    "plt.title(\"Ice Cream Sales Distribution\")\n",
    "plt.show()\n"
   ]
  }
