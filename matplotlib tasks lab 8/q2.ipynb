    "population = [500000, 750000, 300000, 900000, 650000]\n",
    "\n",
    "plt.barh(cities, population)\n",
    "plt.title(\"City Population\")\n",
    "plt.xlabel(\"Population\")\n",
    "plt.show()\n"
   ]
