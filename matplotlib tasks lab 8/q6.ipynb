   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "math = [78,82,90,66,74,85,92,70,88,80]\n",
    "science = [72,80,88,60,70,82,90,68,85,78]\n",
    "\n",
    "plt.scatter(math, science, label=\"marks\")\n",
    "plt.xlabel(\"math\")\n",
    "plt.ylabel(\"science\")\n",
    "plt.title(\"math vs science\")\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
  }
